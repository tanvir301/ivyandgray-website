---
import { Image, getImage } from "astro:assets";
import Placeholder from "./Placeholder.astro";
import type { Photo } from "../lib/images";

interface Props {
  photos: Photo[];
  // Groups photos for the lightbox's previous/next buttons.
  group: string;
  label: string;
  folder: string;
  limit?: number;
  placeholders?: number;
}
const { photos, group, label, folder, limit, placeholders = 3 } = Astro.props;
const shown = limit ? photos.slice(0, limit) : photos;
const items = await Promise.all(
  shown.map(async (p) => ({ ...p, full: await getImage({ src: p.src, width: 1800, format: "webp" }) })),
);
---

<div class="gallery">
  {
    items.length > 0
      ? items.map((p) => (
          <a href={p.full.src} data-lightbox={group} data-alt={p.alt} class="gallery-item">
            <Image src={p.src} alt={p.alt} widths={[400, 700, 1000]} sizes="(max-width: 640px) 100vw, (max-width: 1000px) 50vw, 33vw" />
          </a>
        ))
      : Array.from({ length: placeholders }, () => (
          <Placeholder label={label} hint={`Add photos to src/assets/portfolio/${folder}/`} />
        ))
  }
</div>
