---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site, instagramUrl } from "../site.config";

interface Props {
  title?: string;
  description?: string;
  // Show the announcement banner from site.config.ts above the header.
  announcement?: boolean;
}

const { title, description = site.description, announcement = false } = Astro.props;
const area = site.serviceArea ? ` in ${site.serviceArea}` : "";
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.tagline}${area}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL("/og-image.png", site.url).href;

const business = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: site.name,
  legalName: site.legalName,
  description: site.description,
  url: site.url,
  logo: new URL("/logo-dark.svg", site.url).href,
  image: ogImage,
  ...(site.email && { email: site.email }),
  ...(site.phone && { telephone: site.phone }),
  ...(site.serviceArea && { areaServed: site.serviceArea }),
  ...(instagramUrl && { sameAs: [instagramUrl] }),
};
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#757b6c" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {site.googleSiteVerification && <meta name="google-site-verification" content={site.googleSiteVerification} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Jost:wght@400;500&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(business)} />
    <script is:inline>document.documentElement.classList.add("js");</script>

    {
      site.googleAnalyticsId && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${site.googleAnalyticsId}`} />
          <script is:inline define:vars={{ id: site.googleAnalyticsId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag("js", new Date());
            gtag("config", id);
          </script>
        </>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {
      announcement && site.announcement.text && (
        <a class="announcement" href={site.announcement.href}>
          <span class="announcement-dot" aria-hidden="true"></span>
          <strong>{site.announcement.text}</strong>
          {site.announcement.linkText && <span class="announcement-link">{site.announcement.linkText} <span aria-hidden="true">→</span></span>}
        </a>
      )
    }
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <dialog class="lightbox" aria-label="Photo viewer">
      <img alt="" />
      <button class="lightbox-close" type="button" aria-label="Close">×</button>
      <button class="lightbox-prev" type="button" aria-label="Previous photo">‹</button>
      <button class="lightbox-next" type="button" aria-label="Next photo">›</button>
    </dialog>

    <script>
      // Fade sections in as they scroll into view.
      const reveal = document.querySelectorAll(".reveal");
      if (matchMedia("(prefers-reduced-motion: reduce)").matches || !("IntersectionObserver" in window)) {
        reveal.forEach((el) => el.classList.add("in"));
      } else {
        const io = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("in");
                io.unobserve(e.target);
              }
            }),
          { rootMargin: "0px 0px -8% 0px" },
        );
        reveal.forEach((el) => io.observe(el));
      }

      // Gallery lightbox. Without JavaScript the links simply open the full-size photo.
      const dialog = document.querySelector<HTMLDialogElement>(".lightbox")!;
      const img = dialog.querySelector("img")!;
      let group: HTMLAnchorElement[] = [];
      let index = 0;
      const show = (i: number) => {
        index = (i + group.length) % group.length;
        img.src = group[index].href;
        img.alt = group[index].dataset.alt ?? "";
      };
      document.addEventListener("click", (e) => {
        const link = (e.target as Element).closest<HTMLAnchorElement>("a[data-lightbox]");
        if (!link) return;
        e.preventDefault();
        group = [...document.querySelectorAll<HTMLAnchorElement>(`a[data-lightbox="${link.dataset.lightbox}"]`)];
        show(group.indexOf(link));
        dialog.showModal();
      });
      dialog.querySelector(".lightbox-close")!.addEventListener("click", () => dialog.close());
      dialog.querySelector(".lightbox-prev")!.addEventListener("click", () => show(index - 1));
      dialog.querySelector(".lightbox-next")!.addEventListener("click", () => show(index + 1));
      dialog.addEventListener("click", (e) => e.target === dialog && dialog.close());
      dialog.addEventListener("keydown", (e) => {
        if (e.key === "ArrowLeft") show(index - 1);
        if (e.key === "ArrowRight") show(index + 1);
      });
    </script>
  </body>
</html>
