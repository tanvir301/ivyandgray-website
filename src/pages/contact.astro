---
import Base from "../layouts/Base.astro";
import HowItWorks from "../components/HowItWorks.astro";
import { site, instagramUrl } from "../site.config";
// Paste a new HoneyBook embed code into this file to change the form.
import honeybookEmbed from "../embeds/honeybook.html?raw";

const hasDirectContact = site.email || site.phone || instagramUrl;
---

<Base
  title="Book a Consultation"
  description="Tell us about your wedding or event and book a consultation with Ivy and Gray."
>
  <section class="page-head">
    <div class="container">
      <p class="eyebrow">Contact</p>
      <h1>Book a consultation</h1>
      <p>
        Share your dates, venues and guest count, and pick a time to talk. The more you tell us, the more we can prepare
        before we meet.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-layout">
      <div class="lead-form">
        <Fragment set:html={honeybookEmbed} />
        <noscript>
          <p>Our booking form needs JavaScript. {site.email && <>Email us at <a href={`mailto:${site.email}`}>{site.email}</a> instead.</>}</p>
        </noscript>
      </div>

      <aside class="contact-aside">
        <h2 class="h3">What happens next</h2>
        <ol class="next-steps">
          <li>We review your details and confirm your consultation time.</li>
          <li>We talk through each event, your venues, your style and your budget.</li>
        </ol>
        <p class="next-steps-more"><a href="#how-it-works">See the full process</a></p>
        {
          hasDirectContact && (
            <>
              <h2 class="h3">Prefer to reach out directly?</h2>
              <ul class="contact-list">
                {site.email && <li><a href={`mailto:${site.email}`}>{site.email}</a></li>}
                {site.phone && <li><a href={`tel:${site.phone.replace(/[^\d+]/g, "")}`}>{site.phone}</a></li>}
                {instagramUrl && <li><a href={instagramUrl} rel="noopener">Instagram @{site.instagram}</a></li>}
              </ul>
            </>
          )
        }
      </aside>
    </div>
  </section>

  <HowItWorks tinted />
</Base>
